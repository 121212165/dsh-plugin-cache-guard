{
  "name": "dsh-plugin-cache-guard",
  "version": "0.1.0",
  "description": "dsh plugin: prefix-cache health guard. Detects prompt-instability spikes in the usage stream, estimates wasted tokens, and tells the model to stop mutating the context head.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "cache",
    "prompt-caching",
    "diagnostics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-cache-guard.git"
  },
  "bugs": {
    "url": "https://github.com/121212165/dsh-plugin-cache-guard/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-tools": "^0.1.2-alpha.4",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
